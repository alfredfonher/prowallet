# ============================================================================
# PROWALLET DOCKER ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.docker and fill in your production values
# Then run: docker-compose up --env-file .env.docker
#
# 🔐 SECURITY NOTE: NEVER commit .env.docker to git - add to .gitignore!
# This file contains production secrets that should NOT be in version control
#
# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
DATABASE_URL=postgresql://user:password@db:5432/prowallet?schema=public

# ============================================================================
# SOLANA NETWORK CONFIGURATION (REQUIRED)
# ============================================================================
# SOLANA_NETWORK must be one of: mainnet-beta, testnet, devnet
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
FALLBACK_SOLANA_RPC_URL=https://api.rpcpool.com

# ============================================================================
# HELIUS API CONFIGURATION (REQUIRED)
# ============================================================================
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
HELIUS_PARSE_TRANSACTION_URL=https://api-mainnet.helius-rpc.com/v0/transactions/?api-key=YOUR_HELIUS_API_KEY
HELIUS_PARSE_HISTORY_URL=https://api-mainnet.helius-rpc.com/v0/addresses/{address}/transactions/?api-key=YOUR_HELIUS_API_KEY

# ============================================================================
# KEYPAIRS & PRIVATE KEYS (CRITICAL - NEVER EXPOSE)
# ============================================================================
# These are the actual private keys used for signing blockchain transactions
# Must be in base58 format (as exported from Solana wallet)
TREASURY_PRIVATE_KEY=YOUR_TREASURY_PRIVATE_KEY_BASE58
TREASURY_PUBLIC_KEY=EizJ7W8AbhUAPdSjdEjyKJDEmk7MSJnR6JfH2h2gitLH

# ============================================================================
# JWT AUTHENTICATION (REQUIRED)
# ============================================================================
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# ============================================================================
# PROWALLET PROGRAM & TOKEN CONFIGURATION (REQUIRED)
# ============================================================================
# These are the public keys for the ProWallet program and token
# They should match your deployment configuration
PROWALLET_PROGRAM_ID=7sa2XazRU4R6DcsNLGMWcX4nabCzWwjj3Awfh1gxhtem
TOKEN_MINT_ADDRESS=D8TwbwGGmyucrxPB9uscait27caVgeqYHPpyN3XXjUX3
TREASURY_WALLET=EizJ7W8AbhUAPdSjdEjyKJDEmk7MSJnR6JfH2h2gitLH

# ============================================================================
# POSTGRES DATABASE CREDENTIALS (REQUIRED FOR DOCKER)
# ============================================================================
POSTGRES_DB=prowallet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# ============================================================================
# PAYMENT PROCESSOR API KEYS (OPTIONAL - if using external processors)
# ============================================================================
# COINGATE_API_TOKEN=your_coingate_api_token
# NOWPAYMENTS_API_KEY=your_nowpayments_api_key

# ============================================================================
# ENCRYPTION (OPTIONAL - for encrypted secret storage)
# ============================================================================
# ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# ============================================================================
# FRONTEND CONFIGURATION (WEB CONTAINER)
# ============================================================================
# Frontend environment (production/local)
NEXT_PUBLIC_ENVIRONMENT=production

# This tells the frontend which API to call (CRITICAL)
NEXT_PUBLIC_API_URL=https://servicioshilda.orioncaribe.com/api/v1

# Solana network for frontend
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Helius API Key for frontend transaction parsing (REQUIRED)
NEXT_PUBLIC_HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# ProWallet program ID (public key)
NEXT_PUBLIC_PROWALLET_PROGRAM_ID=7sa2XazRU4R6DcsNLGMWcX4nabCzWwjj3Awfh1gxhtem

# Token configuration (public)
NEXT_PUBLIC_TOKEN_MINT=D8TwbwGGmyucrxPB9uscait27caVgeqYHPpyN3XXjUX3
NEXT_PUBLIC_TOKEN_NAME=ProWallet
NEXT_PUBLIC_TOKEN_SYMBOL=GAPC

# ============================================================================
# CORS CONFIGURATION (API CONTAINER)
# ============================================================================
# Comma-separated list of allowed origins for your frontend deployments
ALLOWED_ORIGINS=https://app.prowallet.com,https://exchange.gapstation.net,https://servicioshilda.orioncaribe.com

# ============================================================================
# OPTIONAL: FEATURE FLAGS
# ============================================================================
# TEST_MODE_FREE_TOKEN=false
# WHITELIST_ENABLED=true
# SKIP_MINT_ON_CONFIRM=false
# MOCK_TOKEN_INFO=false
# ALLOW_OFFCHAIN_LINK=true

# ============================================================================
# OPTIONAL: LOGGING & MONITORING
# ============================================================================
# LOG_LEVEL=info
# MAINTENANCE_MODE=false

# ============================================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================================
# PRICE_CACHE_TTL_MS=43200000
# EXCHANGE_TIMEOUT_MS=7000
# EXCHANGE_MAX_RETRIES=3
# REDIS_URL=redis://redis:6379
