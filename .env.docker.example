# Reference only: current Compose assignments must be sanitized to interpolate this file.

# PostgreSQL database name.
POSTGRES_DB=prowallet
# PostgreSQL role name.
POSTGRES_USER=prowallet
# PostgreSQL password; set a unique local value.
POSTGRES_PASSWORD=
# API PostgreSQL URL; replace the password placeholder locally.
DATABASE_URL=postgresql://prowallet:<set-local-password>@postgres:5432/prowallet
# Redis URL on the Compose network.
REDIS_URL=redis://redis:6379

# API runtime mode.
NODE_ENV=production
# API container port.
PORT=3001
# API route version.
API_VERSION=v1
# API route prefix.
API_PREFIX=/api
# Browser origin published by Compose.
ALLOWED_ORIGINS=http://localhost:3006
# API log verbosity.
LOG_LEVEL=info

# Solana cluster selected by containers.
SOLANA_NETWORK=devnet
# Primary Solana RPC endpoint.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Secondary Solana RPC endpoint.
FALLBACK_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional restricted Helius server key.
HELIUS_API_KEY=
# Reviewed deployed ProWallet program address.
PROWALLET_PROGRAM_ID=
# Reviewed SPL token mint address.
TOKEN_MINT=
# Legacy token mint alias.
TOKEN_MINT_ADDRESS=
# Token display name.
TOKEN_NAME=ProWallet
# Token display symbol.
TOKEN_SYMBOL=GAPC
# Token decimal precision.
TOKEN_DECIMALS=9
# Reviewed authority public address.
AUTHORITY_WALLET=
# Reviewed treasury public address.
TREASURY_WALLET=
# Reviewed provider public address.
PROVIDER_WALLET=
# Reviewed commission public address.
COMMISSION_WALLET=
# Local authority keypair path mounted into the API container.
AUTHORITY_KEYPAIR_PATH=
# Local signer keypair path mounted into the API container.
KEYPAIR_PATH=

# Required random access-token secret.
JWT_SECRET=
# Required independent refresh-token secret.
JWT_REFRESH_SECRET=

# Web environment selector.
NEXT_PUBLIC_ENVIRONMENT=local
# API URL reachable from the host browser.
NEXT_PUBLIC_API_URL=http://localhost:3005/api/v1
# Solana cluster exposed to the browser.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Primary public browser RPC endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Secondary public browser RPC endpoint.
NEXT_PUBLIC_FALLBACK_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional browser-restricted Helius key; this value is public.
NEXT_PUBLIC_HELIUS_API_KEY=
# Reviewed public program address exposed to the browser.
NEXT_PUBLIC_PROWALLET_PROGRAM_ID=
# Reviewed public mint address exposed to the browser.
NEXT_PUBLIC_TOKEN_MINT=
# Browser token display name.
NEXT_PUBLIC_TOKEN_NAME=ProWallet
# Browser token display symbol.
NEXT_PUBLIC_TOKEN_SYMBOL=GAPC
# Enable free-token behavior only in reviewed local testing.
NEXT_PUBLIC_TEST_MODE_FREE_TOKEN=false
