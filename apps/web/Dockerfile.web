FROM node:24-slim

WORKDIR /app

# Step 1: Copiar pnpm config files
COPY pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs* ./

# Step 2: Copiar package.json files
COPY package.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/ ./packages/

# Step 3: Instalar pnpm globalmente
RUN npm install -g pnpm@10.24.0

# Step 4: Instalar todas las dependencias del workspace con pnpm
RUN pnpm install --frozen-lockfile

# Step 5: Copiar el resto del código fuente
COPY . .

# Public build configuration. NEXT_PUBLIC_* values are embedded in the browser bundle.
ARG NEXT_PUBLIC_ENVIRONMENT=local
ARG NEXT_PUBLIC_API_URL_LOCAL=http://localhost:3005/api/v1
ARG NEXT_PUBLIC_API_URL_CLOUD=https://servicioshilda.orioncaribe.com/api/v1
ARG NEXT_PUBLIC_SOLANA_NETWORK=devnet
ARG NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
ARG NEXT_PUBLIC_FALLBACK_SOLANA_RPC_URL=https://api.devnet.solana.com
ARG NEXT_PUBLIC_HELIUS_API_KEY=
ARG NEXT_PUBLIC_PROWALLET_PROGRAM_ID=
ARG NEXT_PUBLIC_TOKEN_MINT=
ENV NEXT_PUBLIC_ENVIRONMENT=$NEXT_PUBLIC_ENVIRONMENT
ENV NEXT_PUBLIC_API_URL_LOCAL=$NEXT_PUBLIC_API_URL_LOCAL
ENV NEXT_PUBLIC_API_URL_CLOUD=$NEXT_PUBLIC_API_URL_CLOUD
ENV NEXT_PUBLIC_SOLANA_NETWORK=$NEXT_PUBLIC_SOLANA_NETWORK
ENV NEXT_PUBLIC_SOLANA_RPC_URL=$NEXT_PUBLIC_SOLANA_RPC_URL
ENV NEXT_PUBLIC_FALLBACK_SOLANA_RPC_URL=$NEXT_PUBLIC_FALLBACK_SOLANA_RPC_URL
ENV NEXT_PUBLIC_HELIUS_API_KEY=$NEXT_PUBLIC_HELIUS_API_KEY
ENV NEXT_PUBLIC_PROWALLET_PROGRAM_ID=$NEXT_PUBLIC_PROWALLET_PROGRAM_ID
ENV NEXT_PUBLIC_TOKEN_MINT=$NEXT_PUBLIC_TOKEN_MINT

# Step 6: Build del web
RUN pnpm --filter exchange-web-ui build

# Step 7: Limpiar archivos y directorios no necesarios para runtime
RUN rm -rf .git .gitignore .turbo .vscode documentation scripts && \
    rm -rf apps/api packages/*/src .env.example prisma && \
    find . -name "*.map" -delete && \
    find . -name "*.ts" -not -path "*/node_modules/*" -delete && \
    find . -name "tsconfig.json" -not -path "*/node_modules/*" -delete && \
    find . -type d -name ".next" -path "*/apps/api/*" -exec rm -rf {} + 2>/dev/null || true && \
    find . -type d -name "dist" -path "*/apps/api/*" -exec rm -rf {} + 2>/dev/null || true

# Variables de entorno
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# Public token display configuration
ENV NEXT_PUBLIC_TOKEN_NAME=ProWallet
ENV NEXT_PUBLIC_TOKEN_SYMBOL=GAPC
ENV NEXT_PUBLIC_TEST_MODE_FREE_TOKEN=false

WORKDIR /app/apps/web

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

CMD ["pnpm", "start"]
