# Explicit web environment selector.
NEXT_PUBLIC_ENVIRONMENT=local
# API URL used by local browser sessions.
NEXT_PUBLIC_API_URL_LOCAL=http://localhost:3001/api/v1
# API URL used by production browser sessions.
NEXT_PUBLIC_API_URL_CLOUD=
# Legacy API URL alias used by some client modules.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Solana cluster shown and used by the browser.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Primary public Solana RPC endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Secondary public Solana RPC endpoint.
NEXT_PUBLIC_FALLBACK_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional browser-restricted Helius key; this value is public.
NEXT_PUBLIC_HELIUS_API_KEY=
# Reviewed deployed ProWallet program address.
NEXT_PUBLIC_PROWALLET_PROGRAM_ID=
# Reviewed SPL token mint address.
NEXT_PUBLIC_TOKEN_MINT=
# Token display name.
NEXT_PUBLIC_TOKEN_NAME=ProWallet
# Token display symbol.
NEXT_PUBLIC_TOKEN_SYMBOL=GAPC
# Enable free-token behavior only in reviewed local testing.
NEXT_PUBLIC_TEST_MODE_FREE_TOKEN=false
