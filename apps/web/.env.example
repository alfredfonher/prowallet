# ============================================
# Environment Configuration
# ============================================
# Explicitly set environment: local or production
# If not set, auto-detection based on hostname will be used
# NEXT_PUBLIC_ENVIRONMENT=production

# ============================================
# API Configuration
# ============================================
# URLs para diferentes entornos
# El sistema detecta automáticamente local vs cloud

# Local development API
NEXT_PUBLIC_API_URL_LOCAL=http://localhost:3001/api/v1

# Production API (change this to match your backend URL)
NEXT_PUBLIC_API_URL_CLOUD=https://servicioshilda.orioncaribe.com/api/v1

# Fallback if no specific environment URL is configured
NEXT_PUBLIC_API_URL=https://servicioshilda.orioncaribe.com/api/v1

# ============================================
# Solana Configuration (using Helius)
# ============================================
# Network: devnet | testnet | mainnet-beta
# Production: mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# RPC URLs (using Helius for reliability)
# Never use https://api.mainnet-beta.solana.com - it returns 403
# Get Helius API key from https://www.helius.dev/
NEXT_PUBLIC_HELIUS_API_KEY=YOUR_HELIUS_API_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
NEXT_PUBLIC_FALLBACK_SOLANA_RPC_URL=https://api.rpcpool.com

# ============================================
# Helius API Endpoints (for transaction parsing)
# ============================================
NEXT_PUBLIC_HELIUS_PARSE_TRANSACTION_URL=https://api-mainnet.helius-rpc.com/v0/transactions/?api-key=YOUR_HELIUS_API_KEY
NEXT_PUBLIC_HELIUS_PARSE_HISTORY_URL=https://api-mainnet.helius-rpc.com/v0/addresses/{address}/transactions/?api-key=YOUR_HELIUS_API_KEY

# ============================================
# ProWallet Program Configuration
# ============================================
NEXT_PUBLIC_PROWALLET_PROGRAM_ID=7sa2XazRU4R6DcsNLGMWcX4nabCzWwjj3Awfh1gxhtem

# ============================================
# Token Configuration
# ============================================
# Devnet Token (deprecated):  BBZ8JF3SwhKVjpUMDe1ycFxLSCpXZPWErPWNpRduYjpH
# Mainnet Token (production):  D8TwbwGGmyucrxPB9uscait27caVgeqYHPpyN3XXjUX3
NEXT_PUBLIC_TOKEN_MINT=D8TwbwGGmyucrxPB9uscait27caVgeqYHPpyN3XXjUX3

# Token naming for the UI
NEXT_PUBLIC_TOKEN_NAME=ProWallet
NEXT_PUBLIC_TOKEN_SYMBOL=GAPC

# ============================================
# Feature Flags
# ============================================
# Free token mode (disable for production)
NEXT_PUBLIC_TEST_MODE_FREE_TOKEN=false

# ============================================
# Authentication (if needed)
# ============================================
# NEXT_PUBLIC_AUTH_PROVIDER=your-provider
# NEXT_PUBLIC_AUTH_CLIENT_ID=your-client-id
