# Solana Devnet Configuration
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
FALLBACK_SOLANA_RPC_URL=https://api.devnet.solana.com

# Token Config (deploy or use existing devnet mint)
TOKEN_MINT_ADDRESS=BBZ8JF3SwhKVjpUMDe1ycFxLSCpXZPWErPWNpRduYjpH

# Wallet (generate devnet keypairs)
TREASURY_WALLET=<generate with solana-keygen>
TREASURY_PRIVATE_KEY=<base58>

# Program
PROWALLET_PROGRAM_ID=<deploy program on devnet>

# Provider
PROVIDER_PUBLIC_KEY=<devnet wallet>
PROVIDER_ATA=<devnet ATA>

# Auth
JWT_SECRET=devnet-secret-change-in-production

# Server
PORT=3001
NODE_ENV=development

# Disable webhooks for MVP
ENABLE_WEBHOOKS=false
