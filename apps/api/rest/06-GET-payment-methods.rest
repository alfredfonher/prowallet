###
# ESTRUCTURA DE RESPUESTA:
# - fiat: Métodos de pago en dinero fíat (tarjeta, transferencia)
# - crypto: Criptomonedas (SOL, USDC, etc.)
# - alternative: Proveedores alternativos (Coingate, NOWPayments)
# - native: Transferencias nativas

###
# CAMPOS EN CADA MÉTODO:
# - name: Nombre del método
# - provider: Proveedor (stripe, solana, coingate, etc.)
# - enabled: Si está disponible
# - minAmount: Monto mínimo
# - maxAmount: Monto máximo
# - fee: Fee/comisión
# - feeType: Tipo de fee (percentage o fixed)
# - processingTime: Tiempo de procesamiento

###
# ERRORES POSIBLES:
# 429: Rate limit excedido
# 500: Error interno del servidor
