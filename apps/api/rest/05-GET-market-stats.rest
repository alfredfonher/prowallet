###
# CAMPOS DISPONIBLES:
# - current_price: Precio actual del token en USD
# - market_cap: Capitalización de mercado total
# - market_cap_rank: Posición en ranking global
# - total_volume: Volumen de trading 24h
# - high_24h: Máximo precio últimas 24h
# - low_24h: Mínimo precio últimas 24h
# - price_change_24h: Cambio de precio absoluto
# - price_change_percentage_24h: Cambio de precio en porcentaje
# - circulating_supply: Tokens en circulación
# - total_supply: Suministro total
# - max_supply: Suministro máximo
# - ath: All time high
# - atl: All time low
# - ath_date: Fecha del ATH
# - atl_date: Fecha del ATL
# - last_updated: Última actualización

###
# ERRORES POSIBLES:
# 429: Rate limit excedido
# 500: Error al conectar con CoinGecko
# 503: Servicio temporalmente no disponible
