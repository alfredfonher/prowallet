# Runtime mode used by the API.
NODE_ENV=development
# HTTP port for local API development.
PORT=3001
# Application log verbosity.
LOG_LEVEL=info
# Version segment used by legacy route builders.
API_VERSION=v1
# Base route prefix exposed by the API.
API_PREFIX=/api
# Public API origin used by callbacks and generated URLs.
BASE_URL=http://localhost:3001
# Full local API URL used by internal clients.
API_BASE_URL=http://localhost:3001/api/v1
# Legacy API base used by standalone scripts.
API_BASE=http://localhost:3001
# Browser origin allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000
# Web origin used for redirects and links.
FRONTEND_URL=http://localhost:3000
# Web base URL used by authentication email flows.
FRONTEND_BASE_URL=http://localhost:3000

# Required PostgreSQL connection; replace the password placeholder locally.
DATABASE_URL=postgresql://prowallet:<set-local-password>@localhost:5432/prowallet
# Optional legacy MongoDB connection; leave blank when unused.
MONGODB_URI=
# Optional Redis connection for cache and Socket.IO coordination.
REDIS_URL=redis://localhost:6379
# Legacy Redis URI alias; leave blank unless a code path requires it.
REDIS_URI=
# Redis connection timeout in milliseconds.
REDIS_CONNECT_TIMEOUT_MS=10000
# Redis command timeout in milliseconds.
REDIS_COMMAND_TIMEOUT_MS=5000
# Maximum Redis reconnect attempts.
REDIS_MAX_RETRIES=3
# Delay between Redis reconnect attempts in milliseconds.
REDIS_RETRY_DELAY_MS=1000
# Delay the initial Redis connection until first use.
REDIS_LAZY_CONNECT=true
# Queue Redis commands while disconnected.
REDIS_ENABLE_OFFLINE_QUEUE=false

# Solana cluster selected by API services.
SOLANA_NETWORK=devnet
# Primary Solana RPC endpoint.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Legacy RPC alias used by standalone scripts.
SOLANA_RPC=https://api.devnet.solana.com
# Secondary Solana RPC endpoint.
FALLBACK_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional restricted Helius server key.
HELIUS_API_KEY=
# Optional restricted Triton server key.
TRITON_API_KEY=
# Reviewed deployed ProWallet program address.
PROWALLET_PROGRAM_ID=
# Reviewed SPL token mint address.
TOKEN_MINT=
# Legacy token mint alias used by some services.
TOKEN_MINT_ADDRESS=
# Display name for the configured token.
TOKEN_NAME=ProWallet
# Display symbol for the configured token.
TOKEN_SYMBOL=GAPC
# On-chain decimal precision for the token.
TOKEN_DECIMALS=9
# Maximum token supply used by pricing logic.
MAX_SUPPLY=1000000000
# Path to a disposable local signer; never commit the file.
KEYPAIR_PATH=
# Path to the authority signer; never commit the file.
AUTHORITY_KEYPAIR_PATH=
# Reviewed authority public address.
AUTHORITY_WALLET=
# Reviewed treasury public address.
TREASURY_WALLET=
# Reviewed treasury public key when required separately.
TREASURY_PUBLIC_KEY=
# Treasury private key; prefer a secret manager and leave blank locally.
TREASURY_PRIVATE_KEY=
# Legacy misspelled treasury key alias; leave blank unless required.
TREAUSURY_PRIVATE_KEY=
# Reviewed provider wallet or local keypair path for scripts.
PROVIDER_WALLET=
# Reviewed commission recipient address.
COMMISSION_WALLET=
# Secret storage implementation selected by the API.
SECRET_STORAGE_TYPE=env
# Encryption key for protected local secret material.
ENCRYPTION_KEY=

# Required random secret for access tokens.
JWT_SECRET=
# Required independent random secret for refresh tokens.
JWT_REFRESH_SECRET=
# Comma-separated administrator emails or identifiers.
ADMIN_USERS=
# Manual-settlement authorization secret; leave blank when disabled.
MANUAL_SETTLE_KEY=

# Email transport type such as smtp or console.
EMAIL_PROVIDER=console
# Email account username; leave blank for console mode.
EMAIL_USER=
# Email account password or app password; leave blank for console mode.
EMAIL_PASSWORD=
# Sender address used in application email.
EMAIL_FROM=noreply@example.test
# SMTP host used by the selected email provider.
SMTP_HOST=localhost
# SMTP port used by the selected email provider.
SMTP_PORT=1025
# Whether SMTP requires TLS from connection start.
SMTP_SECURE=false
# Optional Mailtrap host.
MAILTRAP_HOST=
# Optional Mailtrap port.
MAILTRAP_PORT=
# Whether the Mailtrap connection starts with TLS.
MAILTRAP_SECURE=false

# Optional Stripe server key.
STRIPE_SECRET_KEY=
# Optional Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Optional CoinGate API token.
COINGATE_API_TOKEN=
# Optional NOWPayments API key.
NOWPAYMENTS_API_KEY=
# Optional ProWallet webhook signing secret.
PROWALLET_WEBHOOK_SECRET=
# Optional comma-separated outbound webhook URLs.
OUTBOUND_WEBHOOK_URLS=
# Optional comma-separated n8n webhook URLs.
N8N_WEBHOOK_URLS=
# Webhook request timeout in milliseconds.
OUTBOUND_WEBHOOK_TIMEOUT_MS=5000
# Number of outbound webhook retries.
OUTBOUND_WEBHOOK_RETRY=2

# Pricing implementation selected by purchase services.
PRICING_MODE=static
# Base token price used by static pricing.
BASE_TOKEN_PRICE=0.01
# Multiplier used by bonding-curve pricing.
BONDING_CURVE_MULTIPLIER=1
# Estimated Solana network fee.
GAS_ESTIMATE_SOL=0.000005
# Legacy gas fee alias.
GAS_FEE_SOL=0.000005
# Platform commission charged in SOL.
PLATFORM_COMMISSION_SOL=0
# Platform fee percentage for payment flows.
PLATFORM_FEE_PERCENT=0
# Minimum accepted purchase amount.
MIN_PURCHASE_AMOUNT=1
# Maximum accepted purchase amount.
MAX_PURCHASE_AMOUNT=1000
# Price refresh interval in milliseconds; zero disables scheduling.
PRICE_UPDATE_MS=0
# Price cache lifetime in milliseconds.
PRICE_CACHE_TTL_MS=60000
# Token-info cache lifetime in milliseconds.
TOKENINFO_CACHE_TTL_MS=60000
# Optional CryptoRank key using the current spelling.
CRYPTORANK_API_KEY=
# Legacy CryptoRank key alias.
CRYPTO_RANK_API_KEY=

# Enable free-token behavior only in reviewed local testing.
TEST_MODE_FREE_TOKEN=false
# Enable mock token information only in local testing.
MOCK_TOKEN_INFO=false
# Test wallet public address; never place a private key here.
TEST_WALLET=
# Skip minting after confirmation only for controlled tests.
SKIP_MINT_ON_CONFIRM=false
# Force minting when verification fails; unsafe by default.
FORCE_MINT_ON_VERIFY_FAIL=false
# Enable wallet whitelist enforcement.
WHITELIST_ENABLED=false
# Put the API into maintenance mode.
MAINTENANCE_MODE=false
# Enable legacy rate limiting switch.
RATE_LIMITING_ENABLED=true
# Enable current rate limiting switch.
RATE_LIMIT_ENABLED=true
# General rate limit value used by older middleware.
RATE_LIMIT=100
# Withdrawal polling interval in milliseconds.
WITHDRAW_POLL_INTERVAL=30000
