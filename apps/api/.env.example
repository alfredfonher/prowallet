# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Configuration (replacing MongoDB)
DATABASE_URL=postgresql://prowalletuser:prowalletpass@localhost:5432/prowallet

# ============================================================================
# SOLANA RPC CONFIGURATION (using Helius)
# ============================================================================
# Never use https://api.mainnet-beta.solana.com - it blocks requests with 403
# Use Helius for reliable, high-performance RPC access
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
FALLBACK_SOLANA_RPC_URL=https://api.rpcpool.com

# ============================================================================
# HELIUS API ENDPOINTS (for parsing transactions)
# ============================================================================
# These endpoints require your Helius API key
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
HELIUS_PARSE_TRANSACTION_URL=https://api-mainnet.helius-rpc.com/v0/transactions/?api-key=YOUR_HELIUS_API_KEY
HELIUS_PARSE_HISTORY_URL=https://api-mainnet.helius-rpc.com/v0/addresses/{address}/transactions/?api-key=YOUR_HELIUS_API_KEY

# PROWALLET environment variables
# Token identifiers (from TOKEN-az3...-README.md)
TOKEN_MINT=az3yTBc6iuyUGLAy47Y77eLobYa3vb7GaaFMa9GEMFB
TOKEN_NAME=ProWallet
TOKEN_SYMBOL=GAPC
TOKEN_DECIMALS=9
MAX_SUPPLY=1000000000
PROVIDER_PUBLIC_KEY=EizJ7W8AbhUAPdSjdEjyKJDEmk7MSJnR6JfH2h2gitLH
PROVIDER_ATA=9yReaShDDdhq8VoGQfp7EcNQ4Kt57zNQ9JKbBZkvtdLR
BASE_TOKEN_PRICE=0.01
BONDING_CURVE_MULTIPLIER=1.5
GAS_ESTIMATE_SOL=0.0015

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# CORS Configuration
# List of allowed frontend origins (separated by commas, NO trailing slashes)
# Example: https://exchange.gapstation.net,https://servicioshilda.orioncaribe.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://exchange.gapstation.net,https://servicioshilda.orioncaribe.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PURCHASE_RATE_LIMIT_MAX=10
PURCHASE_RATE_LIMIT_WINDOW_MS=900000

# ProWallet token configuration (additional)
TOKEN_NAME=ProWallet
TOKEN_SYMBOL=GAPC
MIN_PURCHASE_AMOUNT=10
MAX_PURCHASE_AMOUNT=10000

# Payment Processors (fill with real keys in production)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Provider / Authority (from TOKEN README and .env.local)
PROVIDER_WALLET=idl/prowallet.json
KEYPAIR_PATH=idl/prowallet.json
AUTHORITY_KEYPAIR_PATH=idl/prowallet.json
PROGRAM_KEYPAIR=idl/prowallet_contract.json
PROWALLET_IDL=idl/prowallet_contract.json

AUTHORITY_WALLET=EizJ7W8AbhUAPdSjdEjyKJDEmk7MSJnR6JfH2h2gitLH
TOKEN_ACCOUNT=9yReaShDDdhq8VoGQfp7EcNQ4Kt57zNQ9JKbBZkvtdLR

# Treasury wallet for purchases (for local testing)
TREASURY_WALLET=EizJ7W8AbhUAPdSjdEjyKJDEmk7MSJnR6JfH2h2gitLH

# Secret Storage Configuration
SECRET_STORAGE_TYPE=environment
TREAUSURY_PRIVATE_KEY=your_base58_encoded_private_key_here
TREAUSURY_PUBLIC_KEY=EizJ7W8AbhUAPdSjdEjyKJDEmk7MSJnR6JfH2h2gitLH

# For encrypted file storage (alternative to environment variables)
# ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ProWallet program ID (keep configured value from .env.local/.env if applicable)
# If your program id is different, update PROWALLET_PROGRAM_ID
PROWALLET_PROGRAM_ID=7sa2XazRU4R6DcsNLGMWcX4nabCzWwjj3Awfh1gxhtem

# Optional performance / timeouts
AGGREGATION_MAX_TIME_MS=30000
AGGREGATION_MAX_TIME_MS=30000

# Exchange config (defaults)
EXCHANGE_PROVIDER_URL=https://api.coingecko.com/api/v3/coins/markets
EXCHANGE_IDS=bitcoin,ethereum,solana,cardano,polkadot,chainlink,uniswap,litecoin,ripple,polygon
EXCHANGE_VS_CURRENCIES=usd,eur,gbp
EXCHANGE_TIMEOUT_MS=7000
EXCHANGE_MAX_RETRIES=3

# Pricing mode: 'bonding' or 'fixed'
PRICING_MODE=fixed

# ============================================================================
# EMAIL CONFIGURATION (Nodemailer)
# ============================================================================
# Email Provider: gmail, outlook, mailtrap, smtp
EMAIL_PROVIDER=gmail

# Email credentials
# For Gmail: Use App Passwords (not your regular password)
# For Outlook: Use your regular email and password
# Instructions: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Email sender name/address
EMAIL_FROM=noreply@prowallet.com
FRONTEND_BASE_URL=http://localhost:3000

# Gmail configuration (if using EMAIL_PROVIDER=gmail)
# Already handled automatically by Nodemailer

# Outlook configuration (if using EMAIL_PROVIDER=outlook)
# Already handled automatically by Nodemailer

# Mailtrap configuration (if using EMAIL_PROVIDER=mailtrap - for development)
# Get free account at: https://mailtrap.io
# MAILTRAP_HOST=live.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_SECURE=false

# Custom SMTP (if using EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Admin users (comma separated emails)
ADMIN_USERS=admin@prowallet.com,support@prowallet.com
