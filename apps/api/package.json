{
  "name": "prowallet-api",
  "version": "1.0.0",
  "description": "API para interactuar con el smart contract de ProWallet (GAPC) en Solana",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "check-types": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:ts": "ts-node src/server.ts",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "seed": "ts-node src/scripts/seedDatabase.ts",
    "seed:clear": "ts-node src/scripts/seedDatabase.ts --clear",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "prowallet",
    "gapc",
    "solana",
    "blockchain",
    "api",
    "typescript",
    "revenue-sharing",
    "token-2022"
  ],
  "author": "ProWallet Team",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^7.1.0",
    "@trpc/server": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.2.1",
    "@types/node-fetch": "^2.6.13",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bs58": "^5.0.0",
    "coinbase-commerce-node": "^1.0.4",
    "coingate": "^1.2.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^6.9.8",
    "@types/nodemailer": "^6.4.14",
    "nodemon": "^3.1.10",
    "pg": "^8.11.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "status-flow": "^0.1.0",
    "stripe": "^18.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tweetnacl": "^1.0.3",
    "uuid": "^11.0.5",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@types/bs58": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/jest": "^29.5.4",
    "@types/supertest": "^2.0.12",
    "better-sqlite3": "^12.5.0",
    "eslint": "^9.39.1",
    "prisma": "^5.22.0",
    "sinon": "^16.0.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^1.1.5"
  }
}
