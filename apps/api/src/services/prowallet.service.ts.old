    // Get multisig configuration
    async getMultisig(): Promise<Multisig | null> {
        try {
            // Mock multisig - in real implementation, this would fetch from contract
            return {
                requiredSignatures: 2,
                signers: [
                    "GmYsHTNVhnJwpV5yiHa8NwLqnMpan3Qy8LsqA7L9yzH1",
                    "HsYsHTNVhnJwpV5yiHa8NwLqnMpan3Qy8LsqA7L9yzH2",
                ],
                proposalCount: 5,
            };
        } catch (error) {
            console.error("Error getting multisig:", error);
            return null;
        }
    }

    // Create multisig proposal
    async createProposal(
        proposalType: string,
        data: any,
        authority: string
    ): Promise<{
        success: boolean;
        signature?: string;
        proposalId?: number;
        error?: string;
    }> {
        try {
            if (!solanaService.isValidAddress(authority)) {
                return { success: false, error: "Invalid authority address" };
            }

            const multisig = await this.getMultisig();
            if (!multisig) {
                return { success: false, error: "Multisig not configured" };
            }

            if (!multisig.signers.includes(authority)) {
                return {
                    success: false,
                    error: "Authority is not a multisig signer",
                };
            }

            const proposalId = multisig.proposalCount + 1;
            const mockSignature = "proposal_signature_" + Date.now();

            console.log(
                `Created proposal ${proposalId} of type ${proposalType} by ${authority}`
            );

            return {
                success: true,
                signature: mockSignature,
                proposalId,
            };
        } catch (error) {
            console.error("Error creating proposal:", error);
            return {
                success: false,
                error: error instanceof Error ? error.message : "Unknown error",
            };
        }
    }

    // Execute multisig proposal
    async executeProposal(
        proposalId: number,
        authority: string
    ): Promise<{ success: boolean; signature?: string; error?: string }> {
        try {
            if (!solanaService.isValidAddress(authority)) {
                return { success: false, error: "Invalid authority address" };
            }

            const multisig = await this.getMultisig();
            if (!multisig) {
                return { success: false, error: "Multisig not configured" };
            }

            if (!multisig.signers.includes(authority)) {
                return {
                    success: false,
                    error: "Authority is not a multisig signer",
                };
            }

            const mockSignature = "execute_proposal_signature_" + Date.now();

            console.log(`Executed proposal ${proposalId} by ${authority}`);

            return {
                success: true,
                signature: mockSignature,
            };
        } catch (error) {
            console.error("Error executing proposal:", error);
            return {
                success: false,
                error: error instanceof Error ? error.message : "Unknown error",
            };
        }
    }
}

// Export singleton instance
export const prowalletService = new ProWalletService();
