// Set pause state
router.post(
    "/pause",
    strictRateLimitMiddleware,
    [
        validateSolanaAddress("authority"),
        body("isPaused").isBoolean().withMessage("isPaused must be a boolean"),
        handleValidationErrors,
    ],
    async (req: Request, res: Response) => {
        try {
            const { isPaused, authority } = req.body;

            const result = await prowalletService.setPause(isPaused, authority);

            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

export default router;
