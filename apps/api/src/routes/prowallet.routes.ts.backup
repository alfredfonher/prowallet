    }
);

// [swagger documentation removed]
router.get(
    "/transactions/:wallet",
    validateWalletParam,
    async (req: Request, res: Response) => {
        try {
            const { wallet } = req.params;
            const limit = Math.min(
                parseInt(req.query.limit as string) || 10,
                50
            ); // Max 50 transactions
            const transactions = await prowalletService.getWalletTransactions(
                wallet,
                limit
            );
            res.json(
                StatusFlow({
                    code: StatusFlowCodes.OK,
                    lang: "es",
                    extra: transactions,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

