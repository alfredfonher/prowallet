// [swagger documentation removed]
router.post(
    "/users/:userWallet/shares",
    strictRateLimitMiddleware,
    validateSolanaAddress("authority"),
    body("newShares")
        .isInt({ min: 0 })
        .withMessage("New shares must be a non-negative integer"),
    param("userWallet").custom((value) => {
        if (!solanaService.isValidAddress(value)) {
            throw new Error("userWallet must be a valid Solana address");
        }
        return true;
    }),
    handleValidationErrors,
    async (req: Request, res: Response) => {
        try {
            const { userWallet } = req.params;
            const { newShares, authority } = req.body;
            const result = await prowalletService.updateUserShares(
                userWallet,
                newShares,
                authority
            );
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

// [swagger documentation removed]
router.post(
    "/revenue/deposit",
    strictRateLimitMiddleware,
    [
        validateSolanaAddress("authority"),
        body("amount")
            .isFloat({ min: 0.000001 })
            .withMessage("Amount must be greater than 0"),
        body("tokenMint")
            .optional()
            .custom((value) => {
                if (value && !solanaService.isValidAddress(value)) {
                    throw new Error(
                        "Token mint must be a valid Solana address"
                    );
                }
                return true;
            }),
        handleValidationErrors,
    ],
    async (req: Request, res: Response) => {
        try {
            const { amount, tokenMint, authority } = req.body;
            const result = await prowalletService.depositRevenue({
                amount,
                tokenMint,
                authority,
            });
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

// Get contract state
