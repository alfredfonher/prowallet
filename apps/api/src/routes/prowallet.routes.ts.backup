    } catch (error) {
        res.status(500).json(
            StatusFlow({
                code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                lang: "es",
                extra: {
                    error:
                        error instanceof Error
                            ? error.message
                            : "Unknown error",
                },
