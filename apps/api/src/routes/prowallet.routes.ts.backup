});

// [swagger documentation removed]
router.get(
    "/whitelist/:wallet",
    validateWalletParam,
    async (req: Request, res: Response) => {
        try {
            const { wallet } = req.params;
            const isWhitelisted = await prowalletService.isWhitelisted(wallet);
            res.json(
                StatusFlow({
                    code: StatusFlowCodes.OK,
                    lang: "es",
                    extra: {
                        wallet,
                        isWhitelisted,
                    },
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

// [swagger documentation removed]
router.post(
    "/whitelist/add",
    strictRateLimitMiddleware,
    validateWhitelistAdd,
    async (req: Request, res: Response) => {
        try {
            const { wallet, authority } = req.body;
            const result = await prowalletService.addToWhitelist(
                wallet,
                authority
            );
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

