// [swagger documentation removed]
router.post(
    "/transfer",
    strictRateLimitMiddleware,
    validateTransfer,
    async (req: Request, res: Response) => {
        try {
            const { fromWallet, toWallet, amount, tokenMint } = req.body;
            const result = await prowalletService.executeRestrictedTransfer({
                fromWallet,
                toWallet,
                amount,
                tokenMint,
            });
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

// [swagger documentation removed]
router.get(
    "/balance/:wallet",
    validateWalletParam,
    async (req: Request, res: Response) => {
        try {
            const { wallet } = req.params;
            const { tokenMint } = req.query;
            const balance = await prowalletService.getWalletBalance(
