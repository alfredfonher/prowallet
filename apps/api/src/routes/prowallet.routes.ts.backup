// ========== NEW ENDPOINTS FOR COMPLETE CONTRACT INTEGRATION ==========

// [swagger documentation removed]
router.post(
    "/initialize",
    strictRateLimitMiddleware,
    [validateSolanaAddress("authority"), handleValidationErrors],
    async (req: Request, res: Response) => {
        try {
            const { authority } = req.body;
            const result = await prowalletService.initialize(authority);
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

// [swagger documentation removed]
router.post(
    "/users/register",
    strictRateLimitMiddleware,
    [
        validateSolanaAddress("userWallet"),
        validateSolanaAddress("authority"),
        body("shares")
            .isInt({ min: 1 })
            .withMessage("Shares must be a positive integer"),
        body("merkleProof")
            .isArray({ min: 1 })
            .withMessage("Merkle proof is required"),
        handleValidationErrors,
    ],
    async (req: Request, res: Response) => {
        try {
            const { userWallet, shares, merkleProof, authority } = req.body;
            const result = await prowalletService.registerUser({
                userWallet,
                shares,
                merkleProof,
                authority,
            });
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

// [swagger documentation removed]
router.get(
    "/users/:userWallet",
    validateWalletParam,
    async (req: Request, res: Response) => {
        try {
            const { userWallet } = req.params;
            const user = await prowalletService.getUser(userWallet);
            if (user) {
                res.json(
                    StatusFlow({
                        code: StatusFlowCodes.OK,
                        lang: "es",
                        extra: user,
                    })
                );
            } else {
                res.status(404).json(
                    StatusFlow({
                        code: StatusFlowCodes.NOT_FOUND,
                        lang: "es",
                        extra: { error: "User not found" },
                    })
                );
            }
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

