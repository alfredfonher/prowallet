// [swagger documentation removed]
router.post(
    "/multisig/proposals",
    strictRateLimitMiddleware,
    [
        validateSolanaAddress("authority"),
        body("proposalType")
            .isString()
            .notEmpty()
            .withMessage("Proposal type is required"),
        body("data").exists().withMessage("Proposal data is required"),
        handleValidationErrors,
    ],
    async (req: Request, res: Response) => {
        try {
            const { proposalType, data, authority } = req.body;
            const result = await prowalletService.createProposal(
                proposalType,
                data,
                authority
            );
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

// [swagger documentation removed]
router.post(
    "/multisig/proposals/:proposalId/execute",
    strictRateLimitMiddleware,
    [
        param("proposalId")
            .isInt({ min: 1 })
            .withMessage("Proposal ID must be a positive integer"),
        validateSolanaAddress("authority"),
        handleValidationErrors,
    ],
    async (req: Request, res: Response) => {
        try {
            const { proposalId } = req.params;
            const { authority } = req.body;
            const result = await prowalletService.executeProposal(
                parseInt(proposalId),
                authority
            );
            const statusCode = result.success
                ? StatusFlowCodes.OK
                : StatusFlowCodes.BAD_REQUEST;
            res.status(statusCode === StatusFlowCodes.OK ? 200 : 400).json(
                StatusFlow({
                    code: statusCode,
                    lang: "es",
                    extra: result,
                })
            );
        } catch (error) {
            res.status(500).json(
                StatusFlow({
                    code: StatusFlowCodes.INTERNAL_SERVER_ERROR,
                    lang: "es",
                    extra: {
                        error:
                            error instanceof Error
                                ? error.message
                                : "Unknown error",
                    },
                })
            );
        }
    }
);

