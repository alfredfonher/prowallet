/**
 * @swagger
 * /api/v1/purchase/create-payment:
 *   post:
 *     summary: Crear pago alternativo
 *     description: Crea un pago usando métodos alternativos como criptomonedas o tarjetas
 *     tags: [Purchase]
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - walletAddress
 *               - tokenAmount
 *               - paymentCurrency
 *               - paymentMethod
 *             properties:
 *               walletAddress:
 *                 type: string
 *                 example: "GmYsHTNVhnJwpV5yiHa8NwLqnMpan3Qy8LsqA7L9yzH1"
 *                 description: Dirección de wallet de Solana del comprador
 *               tokenAmount:
 *                 type: number
 *                 minimum: 10
 *                 maximum: 10000
 *                 example: 100
 *                 description: Cantidad de tokens TKRC a comprar
 *               paymentCurrency:
 *                 type: string
 *                 example: "BTC"
 *                 description: Moneda de pago (BTC, ETH, USD, EUR, etc.)
 *               paymentMethod:
 *                 type: string
 *                 enum: [crypto, card]
 *                 example: "crypto"
 *                 description: Tipo de método de pago
 *               customerEmail:
 *                 type: string
 *                 format: email
 *                 example: "customer@example.com"
 *                 description: Email del cliente (opcional, requerido para tarjetas)
 *               processorName:
 *                 type: string
 *                 enum: [stripe, coingate, nowpayments]
 *                 example: "coingate"
 *                 description: Procesador específico a usar (opcional)
 *     responses:
 *       200:
 *         description: Pago creado exitosamente
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 success:
 *                   type: boolean
 *                   example: true
 *                 data:
 *                   type: object
 *                   properties:
 *                     transactionId:
 *                       type: string
 *                       format: uuid
 *                     processor:
 *                       type: string
 *                       example: "coingate"
 *                     paymentId:
 *                       type: string
 *                       example: "cg_123456789"
 *                     paymentUrl:
 *                       type: string
 *                       example: "https://coingate.com/pay/cg_123456789"
 *                     qrCode:
 *                       type: string
 *                       example: "https://chart.googleapis.com/chart?chs=200x200&cht=qr..."
 *                     walletAddress:
 *                       type: string
 *                       example: "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa"
 *                     tokenAmount:
 *                       type: number
 *                       example: 100
 *                     paymentAmount:
 *                       type: number
 *                       example: 0.001
 *                     paymentCurrency:
 *                       type: string
 *                       example: "BTC"
 *                     usdAmount:
 *                       type: number
 *                       example: 43
 *                     expiresAt:
 *                       type: string
 *                       format: date-time
 *                     status:
 *                       type: string
 *                       example: "pending"
 *                     instructions:
 *                       type: string
 *                       example: "Send the exact amount to the provided wallet address or scan the QR code"
 *       400:
 *         description: Datos de entrada inválidos o moneda no soportada
 *       429:
 *         description: Demasiadas solicitudes de compra
 *       500:
 *         description: Error interno del servidor
 */
router.post(
    "/create-payment",
    purchaseRateLimit,
    purchaseValidators.createAlternativePayment,
    handleValidationErrors,
    purchaseController.createAlternativePayment.bind(purchaseController)
);

/**
 * @swagger
 * /api/v1/purchase/status/{transactionId}:
 *   get:
 *     summary: Verificar estado de pago alternativo
 *     description: Verifica el estado actual de un pago alternativo (crypto o tarjeta)
 *     tags: [Purchase]
 *     parameters:
 *       - in: path
 *         name: transactionId
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID de la transacción a verificar
 *     responses:
 *       200:
 *         description: Estado del pago obtenido exitosamente
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 success:
 *                   type: boolean
 *                   example: true
 *                 data:
 *                   type: object
 *                   properties:
 *                     transactionId:
 *                       type: string
 *                       format: uuid
 *                     status:
 *                       type: string
 *                       example: "success"
 *                     paymentStatus:
 *                       type: string
 *                       example: "confirmed"
 *                     tokenAmount:
 *                       type: number
 *                       example: 100
 *                     paymentAmount:
 *                       type: number
 *                       example: 0.001
 *                     paymentCurrency:
 *                       type: string
 *                       example: "BTC"
 *                     processor:
 *                       type: string
 *                       example: "coingate"
 *                     processorPaymentId:
 *                       type: string
 *                       example: "cg_123456789"
 *                     completedAt:
 *                       type: string
 *                       format: date-time
 *                     verification:
 *                       type: object
 *                       properties:
 *                         transactionHash:
 *                           type: string
 *                         paidAt:
 *                           type: string
 *                           format: date-time
 *                         amount:
 *                           type: number
 *                         currency:
 *                           type: string
 *       400:
 *         description: ID de transacción inválido
 *       404:
 *         description: Transacción no encontrada
 *       500:
 *         description: Error interno del servidor
 */
router.get(
    "/status/:transactionId",
    purchaseValidators.checkPaymentStatus,
    handleValidationErrors,
    purchaseController.checkPaymentStatus.bind(purchaseController)
);

/**
 * @swagger
 * /api/v1/purchase/confirm-manual/{transactionId}:
 *   post:
 *     summary: Confirmar transacción manualmente
 *     description: Confirma una compra pendiente de forma manual sin verificar signature de blockchain (para desarrollo/testing)
 *     tags: [Purchase]
 *     parameters:
 *       - in: path
 *         name: transactionId
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID de la transacción a confirmar
 *     requestBody:
 *       required: false
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               action:
 *                 type: string
 *                 enum: [confirm]
 *                 example: "confirm"
 *                 description: Acción a realizar
 *               reason:
 *                 type: string
 *                 example: "Manual confirmation for testing"
 *                 description: Motivo de la confirmación manual
 *     responses:
 *       200:
 *         description: Transacción confirmada exitosamente
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 success:
 *                   type: boolean
 *                   example: true
 *                 data:
 *                   type: object
 *                   properties:
 *                     transactionId:
 *                       type: string
 *                       format: uuid
 *                     walletAddress:
 *                       type: string
 *                     tokenAmount:
 *                       type: number
 *                     totalCost:
 *                       type: number
 *                     tokenPrice:
 *                       type: number
 *                     status:
 *                       type: string
 *                       example: "success"
 *                     completedAt:
 *                       type: string
 *                       format: date-time
 *                     signature:
 *                       type: string
 *                       example: "manual-confirmation-1234567890"
 *                     confirmationType:
 *                       type: string
 *                       example: "manual"
 *                 message:
 *                   type: string
 *                   example: "Transaction confirmed successfully! Tokens have been credited to your wallet."
 *       404:
 *         description: Transacción no encontrada o no está pendiente
 *       410:
 *         description: Transacción expirada
 *       500:
 *         description: Error interno del servidor
 */
router.post(
    "/confirm-manual/:transactionId",
    manualTransactionValidators.confirmManualTransaction,
    handleValidationErrors,
    manualTransactionController.confirmManualTransaction.bind(
        manualTransactionController
    )
);

/**
 * @swagger
 * /api/v1/purchase/cancel/{transactionId}:
 *   post:
 *     summary: Cancelar transacción
 *     description: Cancela una compra pendiente
 *     tags: [Purchase]
 *     parameters:
 *       - in: path
 *         name: transactionId
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID de la transacción a cancelar
 *     requestBody:
 *       required: false
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               action:
 *                 type: string
 *                 enum: [cancel]
 *                 example: "cancel"
 *                 description: Acción a realizar
 *               reason:
 *                 type: string
 *                 example: "User requested cancellation"
 *                 description: Motivo de la cancelación
 *     responses:
 *       200:
 *         description: Transacción cancelada exitosamente
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 success:
 *                   type: boolean
 *                   example: true
 *                 data:
 *                   type: object
 *                   properties:
 *                     transactionId:
 *                       type: string
 *                       format: uuid
 *                     walletAddress:
 *                       type: string
 *                     tokenAmount:
 *                       type: number
 *                     totalCost:
 *                       type: number
 *                     status:
 *                       type: string
 *                       example: "cancelled"
 *                     completedAt:
 *                       type: string
 *                       format: date-time
 *                     reason:
 *                       type: string
 *                       example: "Manual cancellation from frontend"
 *                 message:
 *                   type: string
 *                   example: "Transaction cancelled successfully."
 *       404:
 *         description: Transacción no encontrada o no está pendiente
 *       500:
 *         description: Error interno del servidor
 */
router.post(
    "/cancel/:transactionId",
    manualTransactionValidators.cancelTransaction,
    handleValidationErrors,
    manualTransactionController.cancelTransaction.bind(
        manualTransactionController
    )
);

/**
 * @swagger
 * /api/v1/purchase/settle/{transactionId}:
 *   post:
 *     summary: Confirmar compra (alias de confirm) con signature de Solana
 *     description: Alias de `/confirm/{transactionId}` para confirmar una compra pendiente usando la signature de la transacción de Solana.
 *     tags: [Purchase]
 *     parameters:
 *       - in: path
 *         name: transactionId
 *         required: true
 *         schema:
 *           type: string
 *           format: uuid
 *         description: ID de la transacción a confirmar
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - signature
 *             properties:
 *               signature:
 *                 type: string
 *                 example: "3Bq8zR7hUJ5dY9xMz2p4qE6Fv8CgNLo9Xk1mW7jP5RtU4Sw6rN8bA2eD9hG3"
 *                 description: Signature de la transacción de Solana
 *               blockSlot:
 *                 type: integer
 *                 minimum: 1
 *                 example: 123456789
 *                 description: Slot de bloque donde se confirmó la transacción (opcional)
 *     responses:
 *       200:
 *         description: Compra confirmada exitosamente
 *         content:
 *           application/json:
 *             schema:
 *               type: object
 *               properties:
 *                 success:
 *                   type: boolean
 *                   example: true
 *                 data:
 *                   type: object
 *                   properties:
 *                     transactionId:
 *                       type: string
 *                       format: uuid
 *                     signature:
 *                       type: string
 *                     blockSlot:
 *                       type: integer
 *                     walletAddress:
 *                       type: string
 *                     tokenAmount:
 *                       type: number
 *                     totalCost:
 *                       type: number
 *                     status:
 *                       type: string
 *                       example: "success"
 *                     completedAt:
 *                       type: string
 *                       format: date-time
 *       400:
 *         description: Signature inválida o datos incorrectos
 *       404:
 *         description: Transacción no encontrada
 *       410:
 *         description: Transacción expirada
 *       500:
 *         description: Error interno del servidor
 */
router.post(
    "/settle/:transactionId",
    purchaseValidators.settlePurchase,
    handleValidationErrors,
    purchaseController.settlePurchase.bind(purchaseController)
);

export default router;
